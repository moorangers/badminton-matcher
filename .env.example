# คัดลอกไฟล์นี้เป็น .env แล้วปรับตามจริง (.env ถูก gitignore ไว้แล้ว)
# ค่าด้านล่างเป็นแค่ placeholder — ห้ามใช้ค่าจริง/รหัสผ่านจริงในไฟล์นี้ เพราะไฟล์นี้ถูก commit ขึ้น git

MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb://your_mongodb_username:your_mongodb_password@localhost:27017/badminton-matcher?authSource=admin
