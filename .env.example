# คัดลอกไฟล์นี้เป็น .env แล้วปรับตามจริง (.env ถูก gitignore ไว้แล้ว)
# ค่าเริ่มต้นนี้ชี้ไปที่ container mongo ที่มีอยู่แล้วในเครื่อง (root/password บน localhost:27017)
# ใช้ชื่อ database แยกต่างหาก (badminton-matcher) ไม่ชนกับ database ของโปรเจกต์อื่นบน container เดียวกัน

MONGODB_USERNAME=root
MONGODB_PASSWORD=password
MONGODB_URI=mongodb://root:password@localhost:27017/badminton-matcher?authSource=admin
